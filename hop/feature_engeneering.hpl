        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>description_length</field_name>
        <formula>IF(ISBLANK([description]), 0, LEN([description]))</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>has_code_of_conduct</field_name>
        <formula>IF(ISBLANK([codeOfConduct]), 0, IF(OR(LOWER([codeOfConduct]) = "none", LOWER([codeOfConduct]) = "no code of conduct"), 0, 1))</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
