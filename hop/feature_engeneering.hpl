  <transform>
    <type>Formula</type>
    <name>calculate commits per day</name>
    <formulas>
      <formula>
        <field_name>commits_per_day</field_name>
        <formula>IF([repo_age_days] &gt; 0, [defaultBranchCommitCount] / [repo_age_days], 0)</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>stars_per_day</field_name>
        <formula>IF([repo_age_days] &gt; 0, [stars] / [repo_age_days], 0)</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>issues_per_pr</field_name>
        <formula>IF([pullRequests] &gt; 0, [issues] / [pullRequests], [issues])</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
