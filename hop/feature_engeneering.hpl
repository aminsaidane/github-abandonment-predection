    <type>Formula</type>
    <name>derived flags</name>
    <formulas>
      <formula>
        <field_name>has_license</field_name>
        <formula>IF(ISBLANK([license]), 0, 1)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
