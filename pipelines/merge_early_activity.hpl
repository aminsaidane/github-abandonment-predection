    <formulas>
      <formula>
        <field_name>is_org</field_name>
        <formula>IF([owner_type] = "Organization", 1, 0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>early_commits_capped</field_name>
        <formula>IF(ISNUMBER(SEARCH("commits", [capped])), 1, 0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
        <set_na>N</set_na>
      </formula>
    </formulas>
