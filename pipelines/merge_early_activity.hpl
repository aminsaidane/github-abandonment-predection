        <operator>-</operator>
        <leftvalue>early_status</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>ok</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask />
        </value>
        <conditions />
      </condition>
    </compare>
